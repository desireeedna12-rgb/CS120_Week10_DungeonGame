<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DungeonGame"
        mc:Ignorable="d"
        Title="Lilo &amp; Stitch: Island Adventure"
        Height="450"
        Width="800">

    <Grid>
        <!-- Character Selection Background -->
        <Image x:Name="imgBackground"
       Source="Assets/Choose character.png"
       Stretch="Fill"
       Panel.ZIndex="0"/>

        <!-- Stitch inside the left frame -->
        <Image x:Name="imgStitch"
               Source="Assets/Stitch Player.png"
               Width="245"
               Height="245"
               Stretch="Uniform"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               Margin="115,120,0,0"
               Cursor="Hand"
               MouseLeftButtonDown="imgStitch_MouseLeftButtonDown" />

        <!-- Angel inside the right frame -->
        <Image x:Name="imgAngel"
               Source="Assets/Angel player.png"
               Width="220"
               Height="240"
               Stretch="Uniform"
               HorizontalAlignment="Right"
               VerticalAlignment="Top"
               Margin="0,107,108,0"
               Panel.ZIndex="1"
               Cursor="Hand"
               MouseLeftButtonDown="imgAngel_MouseLeftButtonDown" />

        <!-- Invisible button over the PLAY artwork -->
        <Button 
            x:Name="btnPlay"
            Width="210"
            Height="75"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,20"
            Background="Transparent"
            BorderThickness="0"
            Opacity="0"
            Cursor="Hand"
            IsEnabled="False"
            Click="btnPlay_Click"/>
    </Grid>
</Window>
