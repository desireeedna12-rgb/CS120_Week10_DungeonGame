<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DungeonGame"
        mc:Ignorable="d"
        Title="Lilo &amp; Stitch: Island Adventure" Height="450" Width="800">
    <Grid>
        <!-- Background -->
        <Image Source="Assets/Beach background 2.png"
           Stretch="Fill"/>

        <!-- Stitch -->
        <Image x:Name="imgStitch"
           Source="Assets/Stitch Player.png"
           Width="140"
           Height="140"
           HorizontalAlignment="Left"
           VerticalAlignment="Bottom"
           Margin="60,0,0,30"/>

        <!-- Angel -->
        <Image x:Name="imgAngel"
           Source="Assets/Angel player.png"
           Width="140"
           Height="140"
           HorizontalAlignment="Right"
           VerticalAlignment="Bottom"
           Margin="0,0,60,30"/>



    </Grid>
</Window>
